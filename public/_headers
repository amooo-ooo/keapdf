# note: root html documents and spa entry points with standard security headers
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# note: immutable webassembly engine and fingerprinted static assets
/pdfium.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/cursors/*
  Cache-Control: public, max-age=31536000, immutable

# note: font files are not fingerprinted so avoid immutable caching
/fonts/*.woff2
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/fonts/*.css
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

# note: service worker and progressive web app manifest revalidation
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# note: search engine discovery and crawler directives
/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/xml; charset=utf-8

# note: agentic discovery and documentation resources
/llms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/ai-catalog.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/ai-catalog.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/cover.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.md
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
